PREFIX orkgr: <http://orkg.org/orkg/resource/>
PREFIX orkgp: <http://orkg.org/orkg/predicate/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT
  (COALESCE(?hostLabel, STR(?host)) AS ?matrix)
  (COALESCE(?mat3Label, STR(?mat3)) AS ?process_material)
  ?eqe ?metal_precursor ?co_reactant ?gpc ?temp
WHERE {
  # ---- Table 5: device performance
  orkgr:R1469991 orkgp:compareContribution ?c5 .
  ?c5 orkgp:P180031 ?host .
  OPTIONAL { ?host rdfs:label ?hostLabel . }
  OPTIONAL { ?c5 orkgp:P180033 ?eqe . }           # EQE

  # ---- Table 3: ALD process
  orkgr:R1471077 orkgp:compareContribution ?c3 .
  ?c3 orkgp:P9071 ?mat3 .
  OPTIONAL { ?mat3 rdfs:label ?mat3Label . }
  OPTIONAL { ?c3 orkgp:P180042 ?m1 . OPTIONAL { ?m1 rdfs:label ?metal_precursor . } }
  OPTIONAL { ?c3 orkgp:P180043 ?p2 . OPTIONAL { ?p2 rdfs:label ?co_reactant . } }
  OPTIONAL { ?c3 orkgp:P180041 ?gpc . }           # growth per cycle
  OPTIONAL { ?c3 orkgp:P180013 ?temp . }          # temperature

  # ---- Join by normalized material name
  BIND(LCASE(REPLACE(COALESCE(?hostLabel, STR(?host)), "[^A-Za-z0-9]+", "")) AS ?key5)
  BIND(LCASE(REPLACE(COALESCE(?mat3Label, STR(?mat3)), "[^A-Za-z0-9]+", "")) AS ?key3)
  FILTER(?key5 = ?key3)
}
ORDER BY DESC(xsd:decimal(?eqe))
