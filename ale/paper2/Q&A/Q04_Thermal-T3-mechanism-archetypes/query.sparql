PREFIX orkgr: <http://orkg.org/orkg/resource/>
PREFIX orkgp: <http://orkg.org/orkg/predicate/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?mechanism
       (COUNT(DISTINCT ?tuple)   AS ?n_chemistries)
       (COUNT(DISTINCT ?matNorm) AS ?n_materials)
WHERE {
  orkgr:R1563034 orkgp:compareContribution ?c .

  OPTIONAL { ?c orkgp:P183144 ?mat . OPTIONAL { ?mat rdfs:label ?matL . } }
  OPTIONAL { ?c orkgp:P183145 ?r1  . OPTIONAL { ?r1  rdfs:label ?r1L  . } }
  OPTIONAL { ?c orkgp:P183146 ?r2  . OPTIONAL { ?r2  rdfs:label ?r2L  . } }
  OPTIONAL { ?c orkgp:P183147 ?r3  . OPTIONAL { ?r3  rdfs:label ?r3L  . } }

  BIND(LCASE(CONCAT(COALESCE(?r1L, STR(?r1), ""), " ",
                    COALESCE(?r2L, STR(?r2), ""), " ",
                    COALESCE(?r3L, STR(?r3), ""))) AS ?rx)

  # Normalize tuple key
  BIND(CONCAT(STR(COALESCE(?r1L, STR(?r1), "")),"|",
              STR(COALESCE(?r2L, STR(?r2), "")),"|",
              STR(COALESCE(?r3L, STR(?r3), ""))) AS ?tuple)

  # Normalize material label for distinct count
  BIND(LCASE(COALESCE(?matL, STR(?mat))) AS ?matNorm)

  # Mechanism archetype inference
  BIND(
    IF( REGEX(?rx, "\\bhf\\b") && REGEX(?rx, "\\b(tma|dmac|sn\\(acac\\)2|sn\\(acac\\))\\b"),
        "Fluorination + ligand-exchange",
    IF( REGEX(?rx, "\\b(o2|o3)\\b") && REGEX(?rx, "\\b(hacac|hhfac)\\b"),
        "Oxidation + chelation",
    IF( (REGEX(?rx, "\\b(xef2|cl2)\\b") && REGEX(?rx, "\\b(bcl3|wf6|wcl6|ticl4)\\b")),
        "Halogenation & conversion",
        "Other / unclassified"))) AS ?mechanism
  )
}
GROUP BY ?mechanism
ORDER BY DESC(?n_chemistries) DESC(?n_materials) ?mechanism